# Public base URL used to build artifact links returned by MCP tools / API responses
# Example (Heroku): https://your-app-name.herokuapp.com
MCP_PUBLIC_BASE_URL=https://auralmind-mcp-0da2762fd810.herokuapp.com

# Job storage (ephemeral on Heroku dynos unless you add object storage)
AURALMIND_JOBS_DIR=/tmp/auralmind_jobs

# Request / upload size caps
MAX_JSON_MB=100
MAX_UPLOAD_MB=200
MAX_DOWNLOAD_MB=250

# Comma-separated host allowlist for URL ingestion (optional but recommended)
ALLOWED_DOWNLOAD_HOSTS=

# Allow local file paths for local development/testing only (never enable on public deploys)
ALLOW_LOCAL_FILES=false

# Path to your mastering script (vendored in this repo by default)
AURALMIND_SCRIPT_PATH=./auralmind_engine/auralmind_match_maestro_v7_3_expert1.py

# Default preset when the LLM/user doesn't specify one
AURALMIND_DEFAULT_PRESET=competitive_trap

# Thread workers for jobs
JOB_MAX_WORKERS=2
